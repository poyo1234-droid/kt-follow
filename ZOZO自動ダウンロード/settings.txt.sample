# このファイルを settings.txt にコピーして、IDとパスワードを書き込んでください。
# settings.txt は zozo_download.py と同じフォルダに置きます。
# settings.txt は .gitignore に入れてあります（IDとパスワードをリポジトリに入れないため）。
# 削除ツール\settings.txt と同じ「key=value」形式です。

# --- ZOZO BACK OFFICE ログイン -------------------------------------------
# 1段目：ブラウザのポップアップで聞かれる「企業ID / パスワード」
#        （HTTP Basic認証。https://to.zozo.jp/to/ を開いた直後に出るもの）
company_id=
company_password=

# 2段目：ログイン画面に入力する「個人ID / パスワード」
user_id=
user_password=

# --- 保存先 ---------------------------------------------------------------
# ダウンロードしたCSVを置くフォルダ
download_dir=T:\10_業務資料\ファンアライブ\250829サーバー更新\260907-フォローデータ\zozo

# 保存するときの固定ファイル名
file_name=goods_cs.csv

# 前回分を退避するフォルダ（検査に通ったときだけ移動する）
old_dir=T:\10_業務資料\ファンアライブ\250829サーバー更新\260907-フォローデータ\zozo\OLD

# チャンクの境界（各チャンクの終了日をカンマ区切り。YYYY/MM/DD）
# 最終チャンクの終了日は実行日を使うので書かない。境界6つ → 7チャンク。
# 最終チャンクが 120MB か 8万件を超えたらログで警告が出る。そのとき1つ足す。
chunk_boundaries=2021/09/30,2022/12/31,2023/12/31,2024/12/31,2025/08/31,2026/02/28,2026/05/31
